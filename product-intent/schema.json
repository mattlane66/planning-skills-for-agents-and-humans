{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Intent Overlay v1",
  "description": "Typed product-wide behavioral intent beside accepted planning artifacts. Explicit human approval required to move inferred records to accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "planning_package": {
      "type": [
        "string",
        "null"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "status",
        "statement",
        "refs",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"
        },
        "kind": {
          "enum": [
            "capability",
            "requirement",
            "place",
            "affordance",
            "state",
            "transition",
            "rule",
            "interface",
            "invariant",
            "decision",
            "non_goal"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "inferred",
            "working",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "disposition",
              "reason"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "disposition": {
                "enum": [
                  "chosen",
                  "rejected",
                  "deferred"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "reopen_when": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id",
        "paths",
        "confidence"
      ],
      "properties": {
        "intent_id": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "enum": [
            "inferred",
            "confirmed"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
