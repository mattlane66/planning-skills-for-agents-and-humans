{
  "name": "planning-skills-mcp-server",
  "version": "1.6.0",
  "private": true,
  "description": "MCP adapter that exposes Planning Skills SKILL.md files as callable tools.",
  "type": "module",
  "bin": {
    "planning-skills-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/**/*.test.js",
    "check": "npm run build && npm test",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "start:http": "node dist/http.js",
    "dev:http": "tsx src/http.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.8",
    "qs": "6.16.0"
  },
  "engines": {
    "node": ">=20"
  }
}
